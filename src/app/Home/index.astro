---
import { Image } from 'astro:assets'
import { WORK_EXPERIENCES } from '../../../data/general'
import SavePdfResume from '../../components/SavePdfResume'

const ctaFilled =
  'inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 font-medium text-white transition hover:bg-[#0077ed] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-accent/40 active:scale-[0.98] dark:bg-accent-dark dark:hover:bg-[#147ce5]'
---

<section id="home" class="scroll-mt-12">
  <div
    class="mx-auto flex max-w-5xl flex-col-reverse items-center justify-center gap-8 px-5 py-12 sm:px-6 md:min-h-[calc(100svh-3rem)] md:flex-row md:gap-16 md:py-24 md:px-8"
  >
    <div class="flex flex-col items-center gap-4 text-center md:items-start md:text-left">
      <p class="text-base text-muted dark:text-muted-dark sm:text-lg md:text-xl">
        Hi, I'm
      </p>
      <h1
        class="break-words text-4xl font-semibold tracking-tight sm:text-5xl md:text-7xl"
      >
        Charles Randicha Gunawan Santoso
      </h1>
      <p class="text-xl font-semibold text-muted dark:text-muted-dark sm:text-2xl md:text-3xl">
        {WORK_EXPERIENCES[0].title}
      </p>
      <p class="max-w-xl text-base text-muted dark:text-muted-dark sm:text-lg md:text-xl">
        I build websites that are performant, responsive, and maintainable.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 md:justify-start">
        <a href="#contact" class={ctaFilled}> Get in touch </a>
        <SavePdfResume client:idle />
      </div>
    </div>
    <div class="shrink-0">
      <Image
        class="-scale-x-100 rounded-full bg-white object-cover aspect-square w-[180px] sm:w-[220px] md:w-[320px] dark:bg-surface-dark"
        src="/images/self-no-bg.png"
        alt="Portrait of Charles Randicha Gunawan Santoso"
        width="320"
        height="320"
        sizes="(max-width: 640px) 180px, (max-width: 768px) 220px, 320px"
      />
    </div>
  </div>
</section>
