---
import AnimatedAbout from './AnimatedAbout'
import Statistics from './Statistics'
import SavePdfResume from '../../components/SavePdfResume'
---

<section id="about" class="scroll-mt-12 py-16 md:py-32">
  <div class="mx-auto max-w-5xl px-5 sm:px-6 md:px-8">
    <h2
      class="mb-8 text-center text-3xl font-semibold tracking-tight sm:text-4xl md:text-left md:text-5xl"
    >
      About Me
    </h2>
    <AnimatedAbout client:idle className="mb-12" />
    <Statistics client:idle className="mb-12" />
    <div class="flex flex-wrap items-center justify-center gap-6 md:justify-start">
      <SavePdfResume client:idle />
    </div>
  </div>
</section>
