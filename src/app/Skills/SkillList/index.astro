---
import SkillCard from './SkillCard/index.astro'
import { FRONTEND_SKILLS, TOOLS } from '../data.ts'
---

<div>
  <h3 class="mb-4 text-center text-xl font-semibold md:text-left md:text-2xl">
    Frontend
  </h3>
  <div class="mb-10 grid grid-cols-2 gap-3 min-[400px]:grid-cols-3 sm:grid-cols-4 sm:gap-4 md:grid-cols-6">
    {FRONTEND_SKILLS?.map((skill) => <SkillCard skill={skill} />)}
  </div>
  <h3 class="mb-4 text-center text-xl font-semibold md:text-left md:text-2xl">
    Tools
  </h3>
  <div class="grid grid-cols-2 gap-3 min-[400px]:grid-cols-3 sm:grid-cols-4 sm:gap-4 md:grid-cols-6">
    {TOOLS?.map((skill) => <SkillCard skill={skill} />)}
  </div>
</div>
