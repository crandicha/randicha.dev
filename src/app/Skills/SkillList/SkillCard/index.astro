---
import { Image } from 'astro:assets'
import type { TFrontendSkills, TToolsSkills } from '../types'

const { skill } = Astro.props

const getAspectRatio = (skill: TFrontendSkills | TToolsSkills) => {
  if (['React', 'Corel Draw', 'ESLint'].includes(skill)) return 1.12 / 1
  if (['Google Cloud'].includes(skill)) return 1.24 / 1
  if (['SASS'].includes(skill)) return 1.35 / 1
  if (['NodeJS'].includes(skill)) return 1.65 / 1
  if (['Next.js', 'Express'].includes(skill)) return 2 / 1
  if (['Astro'].includes(skill)) return 3 / 1
  if (['Nuxt'].includes(skill)) return 4.3 / 1
  if (['Kubernetes'].includes(skill)) return 6 / 1

  return 1
}
---

<div
  class="flex flex-col items-center gap-3 rounded-2xl bg-white p-3 dark:bg-surface-dark sm:p-4"
>
  <div class="flex flex-1 items-center justify-center rounded-xl bg-white p-2 dark:bg-ink-dark">
    <Image
      src={`/svg/skill/${skill}.svg`}
      alt=""
      widths={[100, 150]}
      width="100"
      height={100 * getAspectRatio(skill)}
      sizes="(max-width: 768px) 80px, 100px"
      class="h-12 w-auto sm:h-14 md:h-16"
    />
  </div>
  <div class="w-full break-words text-center text-xs text-muted dark:text-muted-dark sm:text-sm">
    {skill}
  </div>
</div>
